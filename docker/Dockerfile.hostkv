# Host-KV sglang: built from the host-kv/main branch (pinned at the
# 4ccff141db lineage, the only one with QSA/Qwen3.8-Flash-Next).
# The base image runs sglang as an editable install of
# /sgl-workspace/sglang/python - replacing the tree IS the install
# (this is exactly what the validated bind-mount experiments did).
# ONE image serves both modes: MODE=vanilla (flag off, stock behavior)
# and MODE=tier (see launch-hostkv.sh).
FROM lmsysorg/sglang:dev-qwen38-next-local
COPY python /sgl-workspace/sglang/python
COPY test /sgl-workspace/sglang/test
RUN python -c "import sglang.srt.layers.attention.qsa.host_kv as m; \
import sglang.srt.layers.attention.qsa.glue as g; \
assert hasattr(g, 'resolve_selection_stash'); \
print('hostkv image OK:', m.HostKVTier.__name__)"
